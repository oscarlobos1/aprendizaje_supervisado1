import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd
import os

# Cargar datos
df = pd.read_csv("./Aprendizaje supervisado/data/titanic.csv")



plt.figure(figsize=(10, 6))
sns.heatmap(df.isnull(), cbar=False, yticklabels=False)
plt.title("Mapa de calor de valores nulos")
plt.show()

# Valores faltantes por columna
nulos = df.isnull().sum()

plt.figure(figsize=(10, 6))
sns.barplot(x=nulos.index, y=nulos.values)
plt.xticks(rotation=45)
plt.ylabel("Total de valores faltantes")
plt.xlabel("Columnas")
plt.title("Valores faltantes por columna")
plt.show()



# Eliminar Cabin (demasiados nulos)
df.drop('Cabin', axis=1, inplace=True)

# Imputar Age con la MEDIANA
median_age = df['Age'].median()
df['Age'].fillna(median_age, inplace=True)

# Imputar Embarked con la MODA
df['Embarked'].fillna(df['Embarked'].mode()[0], inplace=True)



print("\nPorcentaje de valores nulos por columna:")
print(round(df.isnull().sum().sort_values(ascending=False) / len(df) * 100, 2))

print("\nTotal de valores nulos por columna:")
print(df.isnull().sum())



print("\nFilas duplicadas:", df.duplicated().sum())



df.drop(['Name', 'Ticket', 'PassengerId'], axis=1, inplace=True)

print(f"\nDespués de limpiar df: {df.shape[0]} filas y {df.shape[1]} columnas.")



os.makedirs("./data", exist_ok=True)
df.to_csv('./data/titanic_clean.csv', index=False)

print("\nArchivo guardado como './data/titanic_clean.csv'")
